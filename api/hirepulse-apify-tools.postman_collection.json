      "name": "Company Intent Radar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"domains\": [\n    \"stripe.com\",\n    \"notion.so\"\n  ],\n  \"country\": \"US\"\n}"
        },
        "url": {
          "raw": "https://api.apify.com/v2/acts/hirepulse~company-intent-radar/run-sync-get-dataset-items?token={{apify_token}}",
          "protocol": "https",
          "host": [
            "api",
            "apify",
            "com"
          ],
          "path": [
            "v2",
            "acts",
            "hirepulse~company-intent-radar",
            "run-sync-get-dataset-items"
          ],
          "query": [
            {
              "key": "token",
              "value": "{{apify_token}}"
            }
          ]
        },
        "description": "Enrich companies with Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Recruitee jobs, Google ads, SEO traffic and 0-100 intent score. $0.03 per company report. 5 free runs.\n\nApify Store: https://apify.com/hirepulse/company-intent-radar\nDocumentation: https://edtool79-collab.github.io/hirepulse-tools/"
      },
