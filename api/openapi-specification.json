{
  "openapi": "3.1.0",
  "info": {
    "title": "HirePulse Apify Data Tools API",
    "description": "OpenAPI 3.1 specification for HirePulse pay-per-use data tools running on Apify. Use with LangChain, LlamaIndex, AutoGen, Flowise, or OpenAI Custom Actions.\n\nAll tools run on the Apify Store (https://apify.com/hirepulse) with pay-per-use billing and $5/month platform credit included.",
    "version": "1.0.0",
    "contact": {
      "name": "HirePulse",
      "url": "https://edtool79-collab.github.io/hirepulse-tools/"
    }
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify Production API Gateway"
    }
  ],
  "paths": {
    "/acts/hirepulse~company-intent-radar/run-sync-get-dataset-items": {
      "post": {
        "summary": "Company Intent Radar",
        "description": "Enrich companies with Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Recruitee jobs, Google ads, SEO traffic and 0-100 intent score. $0.03 per company report. 5 free runs.\nApify Store Page: https://apify.com/hirepulse/company-intent-radar",
        "operationId": "run_company_intent_radar",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Your Apify API Token (get $5/month free at https://apify.com/pricing)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "domains": [
                    "stripe.com",
                    "notion.so"
                  ],
                  "country": "US"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronous run completed and dataset items returned as a JSON array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
